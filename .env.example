# 管理入口账户（必须自定义强密码，至少 12 个字符）
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password-2026

# 邮件收件人（多个地址可用逗号分隔）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_TLS_MODE=implicit
SMTP_USER=12345678@qq.com
SMTP_PASSWORD=replace-with-your-smtp-authorization-code
SMTP_FROM=12345678@qq.com
SMTP_TO=recipient@example.com

# 抓取配置
POLL_INTERVAL=5m
MAX_NEW_PER_POLL=100
DATA_DIR=/data
LISTEN_ADDR=:8080

# 可选：启动时一次性写入初始规则，后续由 Web 页面动态修改
SEED_TOPIC_URL=https://linux.do/t/topic/2696141/33528
SEED_USERNAME=Andrew-hh

# 如有获准使用的 Discourse API Key，可按需配置；通常公开接口不需要
# DISCOURSE_API_KEY=
# DISCOURSE_API_USERNAME=
